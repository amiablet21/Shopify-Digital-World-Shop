{% comment %}
  The wholesale gate: what anonymous and unapproved visitors see instead of
  the storefront. Signed-in-but-unapproved customers get the pending state.
{% endcomment %}

<div class="dw-gate">
  <div class="dw-gate__card dw-panel-box">
    <span class="dw-gate__mark">Digital World Shop</span>
    {%- if customer -%}
      <h1>Your application is being reviewed</h1>
      <p>
        You are signed in as {{ customer.email }}, but this account is not approved for
        wholesale access yet. We review applications within one business day and email
        you the decision.
      </p>
      <div class="dw-gate__actions">
        <a class="dw-btn-line" href="/pages/apply">Update Application</a>
        <a class="dw-btn-line" href="{{ routes.account_logout_url }}">Sign Out</a>
      </div>
    {%- else -%}
      <h1>Wholesale electronics, by application</h1>
      <p>
        Digital World Shop is a B2B wholesale storefront. Catalog and pricing are
        visible to approved business accounts only.
      </p>
      <div class="dw-gate__actions">
        <a class="dw-btn-money dw-gate__cta" href="/pages/apply">Apply for Access</a>
        <a class="dw-btn-line dw-gate__cta" href="{{ routes.account_login_url }}">Sign In</a>
      </div>
      <p class="dw-gate__note">Approval takes one business day. Already approved? Sign in with your work email.</p>
    {%- endif -%}
  </div>
</div>

{% style %}
  .dw-gate {
    font-family: var(--dw-font);
    color: var(--dw-text);
    min-height: 60vh;
    display: grid;
    place-items: center;
    padding: 4rem 2.4rem;
  }
  .dw-gate__card {
    max-width: 52rem;
    width: 100%;
    padding: 3.2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    align-items: center;
  }
  .dw-gate__mark {
    font-family: var(--dw-wordmark);
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dw-accent);
  }
  .dw-gate__card h1 {
    font-family: var(--dw-font);
    font-size: 2.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
    line-height: 1.3;
  }
  .dw-gate__card p {
    color: var(--dw-text-2);
    font-size: 1.35rem;
    line-height: 1.55;
    margin: 0;
    max-width: 42rem;
  }
  .dw-gate__actions {
    display: flex;
    gap: 1rem;
    margin-top: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .dw-gate__cta {
    padding: 1rem 2rem;
    font-size: 1.35rem;
    text-decoration: none;
  }
  .dw-gate__note {
    font-size: 1.15rem;
    color: var(--dw-text-3);
  }
{% endstyle %}
