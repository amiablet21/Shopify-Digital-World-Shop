{% comment %}
  Digital World Shop: printable and exportable full price list.
  Read-only ledger over collections.all with client-side search,
  window.print() styling, and CSV export built from row data attributes.
  Metafields used: custom.condition ("N" or "R"), custom.moq (integer).
{% endcomment %}

{%- liquid
  assign approved = false
  if section.settings.enable_gating == false
    assign approved = true
  elsif customer and customer.tags contains section.settings.approved_tag
    assign approved = true
  endif
-%}

<div class="dw-pl page-width-desktop" id="DwPl-{{ section.id }}">
  <p class="dw-pl__printnote">Digital World Shop Price List. Prices subject to change.</p>

  <div class="dw-pl__head">
    <h1>{{ section.settings.heading | default: 'Price List' }}</h1>
    <span class="dw-pl__sub">{{ collections.all.products_count }} SKUs</span>
    <span class="dw-pl__stamp">EXW pricing</span>
  </div>

  <div class="dw-pl__toolbar">
    <label class="dw-pl__searchbox">
      <input
        type="search"
        data-dw-pl-search
        placeholder="Search SKU or product"
        aria-label="Search price list"
      >
    </label>
    <span class="dw-pl__grow"></span>
    <button type="button" class="dw-btn-line" onclick="window.print()">Print</button>
    <button type="button" class="dw-btn-line" data-dw-pl-export>Export CSV</button>
  </div>

  <div class="dw-pl__panelwrap dw-panel-box">
    <div class="dw-pl__scroll">
      <div class="dw-pl__cols dw-pl__cols--head">
        <span class="dw-lbl">SKU</span>
        <span class="dw-lbl">Product</span>
        <span class="dw-lbl">Brand</span>
        <span class="dw-lbl">Cond</span>
        <span class="dw-lbl dw-pl__r">MOQ</span>
        <span class="dw-lbl dw-pl__r">Unit Price</span>
        <span class="dw-lbl dw-pl__r">Stock</span>
      </div>

      {%- paginate collections.all.products by section.settings.products_per_page -%}
        {%- for product in collections.all.products -%}
          {%- liquid
            assign variant = product.selected_or_first_available_variant
            assign moq = product.metafields.custom.moq.value | default: 1
            assign cond = product.metafields.custom.condition.value | slice: 0 | upcase
            assign cond_word = ''
            if cond == 'N'
              assign cond_word = 'New'
            elsif cond == 'R'
              assign cond_word = 'Refurbished'
            endif
            assign soldout = false
            unless variant.available
              assign soldout = true
            endunless
            assign qty_known = false
            if variant.inventory_management == 'shopify'
              assign qty_known = true
            endif
            assign stock_text = 'In stock'
            if soldout
              assign stock_text = 'Out'
            elsif qty_known
              assign stock_text = variant.inventory_quantity
            endif
            assign price_text = ''
            if approved
              assign price_text = variant.price | money | strip_html
            endif
          -%}
          <div
            class="dw-pl__cols dw-pl__row{% if soldout %} dw-pl__row--soldout{% endif %}"
            data-dw-pl-row
            data-sku="{{ variant.sku | escape }}"
            data-title="{{ product.title | escape }}"
            data-brand="{{ product.vendor | escape }}"
            data-cond="{{ cond_word }}"
            data-moq="{{ moq }}"
            data-price="{{ price_text | escape }}"
            data-stock="{{ stock_text }}"
          >
            <span class="dw-pl__sku dw-mono">{{ variant.sku }}</span>

            <span class="dw-pl__title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </span>

            <span class="dw-pl__brand">{{ product.vendor }}</span>

            <span>
              {%- if cond == 'N' -%}
                <span class="dw-cond dw-cond--n" title="New">N</span>
              {%- elsif cond == 'R' -%}
                <span class="dw-cond dw-cond--r" title="Refurbished">R</span>
              {%- endif -%}
            </span>

            <span class="dw-mono dw-pl__moq dw-pl__r">{{ moq }}</span>

            <span class="dw-pl__price dw-pl__r">
              {%- if approved -%}
                <span class="dw-mono dw-pl__pricenum">{{ variant.price | money }}</span>
                {%- if variant.compare_at_price > variant.price -%}
                  <s class="dw-mono dw-pl__was">{{ variant.compare_at_price | money }}</s>
                {%- endif -%}
              {%- else -%}
                <a class="dw-pl__gate" href="{{ routes.account_login_url }}">Sign in for pricing</a>
              {%- endif -%}
            </span>

            <span class="dw-pl__stock dw-pl__r">
              {%- if soldout -%}
                <span class="dw-soldtag">Out</span>
              {%- elsif qty_known -%}
                <span class="dw-mono">{{ variant.inventory_quantity }}</span>
              {%- else -%}
                <span class="dw-mono">In stock</span>
              {%- endif -%}
            </span>
          </div>
        {%- else -%}
          <div class="dw-pl__empty">No products found.</div>
        {%- endfor -%}

        <div class="dw-pl__empty" data-dw-pl-empty hidden>No products match this search.</div>

        {%- if paginate.pages > 1 -%}
          <div class="dw-pl__pagination">
            {% render 'pagination', paginate: paginate %}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>

  <p class="dw-pl__rowcount" data-dw-pl-count></p>
</div>

{% style %}
  .dw-pl {
    font-family: var(--dw-font);
    color: var(--dw-text);
    max-width: 118rem;
    margin: 0 auto;
    padding: 1.8rem 2.4rem 6.4rem;
  }
  .dw-pl__printnote {
    display: none;
  }
  .dw-pl__head {
    display: flex;
    align-items: baseline;
    gap: 1.2rem;
    margin-bottom: 1.4rem;
  }
  .dw-pl__head h1 {
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
    font-family: var(--dw-font);
  }
  .dw-pl__sub {
    color: var(--dw-text-2);
    font-size: 1.25rem;
  }
  .dw-pl__stamp {
    margin-left: auto;
    color: var(--dw-text-3);
    font-size: 1.2rem;
  }
  .dw-pl__toolbar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
  }
  .dw-pl__searchbox {
    display: flex;
    align-items: center;
    border: 1px solid var(--dw-line-strong);
    background: var(--dw-panel);
    border-radius: var(--dw-r);
    padding: 0.6rem 1rem;
    min-width: 22rem;
  }
  .dw-pl__searchbox:focus-within {
    border-color: var(--dw-accent);
  }
  .dw-pl__searchbox input {
    border: 0;
    outline: none;
    background: none;
    width: 100%;
    font-family: var(--dw-font);
    font-size: 1.25rem;
    color: var(--dw-text);
  }
  .dw-pl__grow {
    flex: 1;
  }
  .dw-pl__panelwrap {
    overflow: hidden;
  }
  .dw-pl__scroll {
    overflow-x: auto;
  }
  .dw-pl__cols {
    display: grid;
    align-items: center;
    gap: 1.2rem;
    grid-template-columns: 15.8rem minmax(24rem, 1fr) 7.8rem 4.4rem 5.6rem 11rem 8rem;
    padding: 0 1.4rem;
    min-width: 92rem;
  }
  .dw-pl__cols--head {
    background: var(--dw-panel-2);
    border-bottom: 1px solid var(--dw-line);
  }
  .dw-pl__cols--head > span {
    padding: 0.7rem 0;
  }
  .dw-pl__r {
    text-align: right;
  }
  .dw-pl__row {
    border-top: 1px solid var(--dw-line);
    padding-top: 0.8rem;
    padding-bottom: 0.8rem;
  }
  .dw-pl__row:first-of-type {
    border-top: 0;
  }
  .dw-pl__row:hover {
    background: var(--dw-panel-2);
  }
  .dw-pl__row--soldout .dw-pl__title a,
  .dw-pl__row--soldout .dw-pl__sku {
    color: var(--dw-text-3);
  }
  .dw-pl__sku {
    font-size: 1.15rem;
    color: var(--dw-text-2);
  }
  .dw-pl__title {
    min-width: 0;
  }
  .dw-pl__title a {
    display: block;
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--dw-text);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dw-pl__title a:hover {
    color: var(--dw-accent);
  }
  .dw-pl__brand {
    font-size: 1.2rem;
    color: var(--dw-text-2);
  }
  .dw-pl__moq {
    font-size: 1.25rem;
    color: var(--dw-text-2);
  }
  .dw-pl__pricenum {
    font-size: 1.3rem;
    font-weight: 700;
  }
  .dw-pl__was {
    display: block;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--dw-text-3);
  }
  .dw-pl__gate {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--dw-accent);
    text-decoration: none;
  }
  .dw-pl__gate:hover {
    text-decoration: underline;
  }
  .dw-pl__stock .dw-mono {
    font-size: 1.25rem;
    font-weight: 600;
  }
  .dw-pl__empty {
    text-align: center;
    color: var(--dw-text-3);
    padding: 4.4rem 0;
    font-size: 1.3rem;
  }
  .dw-pl__pagination {
    padding: 1.2rem;
    border-top: 1px solid var(--dw-line);
  }
  .dw-pl__rowcount {
    font-size: 1.2rem;
    color: var(--dw-text-3);
    margin-top: 0.8rem;
  }

  @media print {
    body {
      background: #fff;
      color: #000;
    }
    .dw-announce,
    .dw-header,
    .dw-pl__toolbar,
    .dw-pl__pagination,
    .dw-pl__rowcount {
      display: none !important;
    }
    .dw-pl {
      max-width: none;
      padding: 0;
    }
    .dw-pl__printnote {
      display: block;
      font-size: 1.1rem;
      color: #000;
      border-bottom: 1px solid #000;
      padding-bottom: 0.6rem;
      margin: 0 0 1rem;
    }
    .dw-pl__sub,
    .dw-pl__stamp {
      color: #000;
    }
    .dw-pl__panelwrap {
      border: 1px solid #000;
      background: #fff;
      overflow: visible;
    }
    .dw-pl__scroll {
      overflow: visible;
    }
    .dw-pl__cols {
      min-width: 0;
    }
    .dw-pl__cols--head {
      background: #fff;
      border-bottom: 1px solid #000;
    }
    .dw-pl__row {
      border-top: 1px solid #bbb;
    }
    .dw-pl__row:hover {
      background: #fff;
    }
    .dw-lbl,
    .dw-pl__sku,
    .dw-pl__brand,
    .dw-pl__moq,
    .dw-pl__title a,
    .dw-pl__stock .dw-mono {
      color: #000;
    }
    .dw-pl__was {
      color: #555;
    }
    .dw-cond--n,
    .dw-cond--r {
      color: #000;
      border-color: #000;
      background: #fff;
    }
    .dw-soldtag {
      color: #000;
    }
  }
{% endstyle %}

<script>
  (function () {
    var root = document.getElementById('DwPl-{{ section.id }}');
    if (!root) return;

    var rows = Array.prototype.slice.call(root.querySelectorAll('[data-dw-pl-row]'));
    var searchInput = root.querySelector('[data-dw-pl-search]');
    var emptyMsg = root.querySelector('[data-dw-pl-empty]');
    var countEl = root.querySelector('[data-dw-pl-count]');

    function visibleRows() {
      return rows.filter(function (r) {
        return !r.hidden;
      });
    }

    function updateCount() {
      if (countEl) countEl.textContent = visibleRows().length + ' SKUs shown';
    }

    if (searchInput) {
      searchInput.addEventListener('input', function () {
        var q = searchInput.value.trim().toLowerCase();
        var shown = 0;
        rows.forEach(function (r) {
          var haystack = (r.getAttribute('data-sku') + ' ' + r.getAttribute('data-title')).toLowerCase();
          var hit = !q || haystack.indexOf(q) > -1;
          r.hidden = !hit;
          if (hit) shown++;
        });
        if (emptyMsg) emptyMsg.hidden = shown > 0;
        updateCount();
      });
    }

    var exportBtn = root.querySelector('[data-dw-pl-export]');
    if (exportBtn) {
      exportBtn.addEventListener('click', function () {
        var esc = function (v) {
          v = v == null ? '' : String(v);
          return '"' + v.replace(/"/g, '""') + '"';
        };
        var lines = ['SKU,Product,Brand,Condition,MOQ,Unit Price,Stock'];
        visibleRows().forEach(function (r) {
          lines.push(
            [
              r.getAttribute('data-sku'),
              r.getAttribute('data-title'),
              r.getAttribute('data-brand'),
              r.getAttribute('data-cond'),
              r.getAttribute('data-moq'),
              r.getAttribute('data-price'),
              r.getAttribute('data-stock')
            ]
              .map(esc)
              .join(',')
          );
        });
        var blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'price-list.csv';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }

    updateCount();
  })();
</script>

{% schema %}
{
  "name": "DW Price List",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Price List"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 50,
      "max": 250,
      "step": 50,
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "enable_gating",
      "label": "Hide prices from non-approved customers",
      "default": false
    },
    {
      "type": "text",
      "id": "approved_tag",
      "label": "Approved customer tag",
      "default": "approved"
    }
  ],
  "presets": [{ "name": "DW Price List" }]
}
{% endschema %}
