{% comment %}
  Digital World Shop: wholesale account application page.
  Left: application form posting through Shopify's contact form so submissions
  email the store owner. Right: sticky sign-in panel for approved accounts.
{% endcomment %}

<div class="dw-apply">
  <div class="dw-apply__cols">
    <section class="dw-apply__main" aria-label="{{ section.settings.heading | escape }}">
      <h1 class="dw-apply__h1">{{ section.settings.heading }}</h1>
      <p class="dw-apply__intro">{{ section.settings.intro }}</p>

      <div class="dw-apply__facts">
        {%- if section.settings.fact_1 != blank -%}
          <div class="dw-apply__fact">{{ section.settings.fact_1 }}</div>
        {%- endif -%}
        {%- if section.settings.fact_2 != blank -%}
          <div class="dw-apply__fact">{{ section.settings.fact_2 }}</div>
        {%- endif -%}
        {%- if section.settings.fact_3 != blank -%}
          <div class="dw-apply__fact">{{ section.settings.fact_3 }}</div>
        {%- endif -%}
      </div>

      <div class="dw-apply__panel dw-panel-box">
        <div class="dw-apply__strip"><span class="dw-lbl">Application</span></div>

        <form class="dw-apply__form" id="DwApplyForm">
          <div class="dw-apply__success" id="DwApplySuccess" hidden>
            <span class="dw-apply__success-tile" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 12.5l5.5 5.5L20 6.5"/>
              </svg>
            </span>
            <h2 class="dw-apply__success-h" tabindex="-1">Application received</h2>
            <p class="dw-apply__success-p">We review applications within one business day and email you the decision.</p>
          </div>

          <div class="dw-apply__errors" id="DwApplyError" role="alert" hidden></div>

          <div class="dw-apply__grid" id="DwApplyGrid">
            <div class="dw-apply__field">
              <label class="dw-lbl" for="DwApplyEmail">Work email</label>
              <input id="DwApplyEmail" type="email" name="email" autocomplete="email" required>
            </div>
            <div class="dw-apply__field">
              <label class="dw-lbl" for="DwApplyCompany">Legal business name</label>
              <input id="DwApplyCompany" type="text" name="company" autocomplete="organization" required>
            </div>
            <div class="dw-apply__field">
              <label class="dw-lbl" for="DwApplyContact">Contact name</label>
              <input id="DwApplyContact" type="text" name="contact" autocomplete="name" required>
            </div>
            <div class="dw-apply__field">
              <label class="dw-lbl" for="DwApplyPhone">Phone</label>
              <input id="DwApplyPhone" type="tel" name="phone" autocomplete="tel" required>
            </div>
            <div class="dw-apply__field">
              <label class="dw-lbl" for="DwApplyEin">EIN</label>
              <input id="DwApplyEin" type="text" class="dw-mono" name="ein" placeholder="12-3456789" required>
            </div>
            <div class="dw-apply__field">
              <label class="dw-lbl" for="DwApplyCert">Resale certificate number</label>
              <input id="DwApplyCert" type="text" class="dw-mono" name="resaleCert">
            </div>
            <div class="dw-apply__field">
              <label class="dw-lbl" for="DwApplyType">Business type</label>
              <select id="DwApplyType" name="businessType">
                <option>Reseller</option>
                <option>Retailer</option>
                <option>Refurbisher</option>
                <option>Exporter</option>
                <option>IT Service Provider</option>
                <option>Other</option>
              </select>
            </div>
            <div class="dw-apply__field">
              <label class="dw-lbl" for="DwApplyVolume">Estimated monthly volume</label>
              <select id="DwApplyVolume" name="volume">
                <option>Under $5,000</option>
                <option>$5,000 to $25,000</option>
                <option>$25,000 to $100,000</option>
                <option>Over $100,000</option>
              </select>
            </div>
            <div class="dw-apply__field dw-apply__field--full">
              <label class="dw-lbl" for="DwApplyBody">Anything we should know (optional)</label>
              <textarea id="DwApplyBody" name="message" rows="3"></textarea>
            </div>
          </div>

          <div class="dw-apply__foot" id="DwApplyFoot">
            <span class="dw-apply__note">We review applications within one business day.</span>
            <button type="submit" class="dw-btn-money">Submit Application</button>
          </div>
        </form>

        <script>
          (function () {
            var form = document.getElementById('DwApplyForm');
            if (!form) return;
            form.addEventListener('submit', function (event) {
              event.preventDefault();
              var errorEl = document.getElementById('DwApplyError');
              var button = form.querySelector('[type="submit"]');
              var data = {};
              new FormData(form).forEach(function (value, key) { data[key] = value; });
              button.disabled = true;
              errorEl.hidden = true;
              fetch('/apps/dw/apply', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
              })
                .then(function (response) {
                  return response.json().then(function (payload) {
                    if (!response.ok) throw new Error(payload.error || 'Something went wrong. Try again.');
                  });
                })
                .then(function () {
                  document.getElementById('DwApplyGrid').hidden = true;
                  document.getElementById('DwApplyFoot').hidden = true;
                  var success = document.getElementById('DwApplySuccess');
                  success.hidden = false;
                  success.querySelector('.dw-apply__success-h').focus();
                })
                .catch(function (error) {
                  errorEl.textContent = error.message;
                  errorEl.hidden = false;
                })
                .finally(function () {
                  button.disabled = false;
                });
            });
          })();
        </script>
      </div>
    </section>

    <aside class="dw-apply__side" aria-label="Sign in">
      <div class="dw-panel-box">
        <div class="dw-apply__strip"><span class="dw-lbl">Already approved? Sign in</span></div>
        <div class="dw-apply__side-body">
          <p class="dw-apply__side-p">Sign in with your business email to see wholesale pricing.</p>
          <a class="dw-apply__signin" href="{{ routes.account_login_url }}">Sign In</a>
        </div>
      </div>
      <p class="dw-apply__side-note">Your login is your approved business account.</p>
    </aside>
  </div>
</div>

{% style %}
  .dw-apply {
    font-family: var(--dw-font);
    color: var(--dw-text);
    max-width: 102rem;
    margin: 0 auto;
    padding: 2.6rem 2.4rem 6.4rem;
  }
  .dw-apply__cols {
    display: grid;
    grid-template-columns: 1fr 38rem;
    gap: 2.4rem;
    align-items: start;
  }
  .dw-apply__h1 {
    font-family: var(--dw-font);
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.6rem;
  }
  .dw-apply__intro {
    color: var(--dw-text-2);
    font-size: 1.3rem;
    margin: 0 0 1.8rem;
    max-width: 52ch;
  }
  .dw-apply__facts {
    border-top: 1px solid var(--dw-line);
    margin-bottom: 2rem;
  }
  .dw-apply__fact {
    padding: 1rem 0.2rem;
    border-bottom: 1px solid var(--dw-line);
    font-size: 1.3rem;
  }
  .dw-apply__strip {
    background: var(--dw-panel-2);
    border-bottom: 1px solid var(--dw-line);
    padding: 0.8rem 1.6rem;
  }
  .dw-apply__panel {
    overflow: hidden;
  }
  .dw-apply__form {
    padding: 1.6rem;
  }
  .dw-apply__errors {
    background: var(--dw-bad-soft);
    border: 1px solid var(--dw-bad);
    border-radius: var(--dw-r);
    color: var(--dw-bad);
    font-size: 1.25rem;
    padding: 1rem 1.4rem;
    margin-bottom: 1.4rem;
  }
  .dw-apply__errors ul {
    margin: 0;
    padding-left: 1.6rem;
  }
  .dw-apply__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem 1.4rem;
  }
  .dw-apply__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .dw-apply__field--full {
    grid-column: 1 / -1;
  }
  .dw-apply__field input,
  .dw-apply__field select,
  .dw-apply__field textarea {
    background: var(--dw-panel);
    border: 1px solid var(--dw-line-strong);
    border-radius: var(--dw-r);
    padding: 0.8rem 1rem;
    font-family: var(--dw-font);
    font-size: 1.3rem;
    color: var(--dw-text);
    width: 100%;
  }
  .dw-apply__field input.dw-mono {
    font-family: var(--dw-mono);
    font-size: 1.25rem;
  }
  .dw-apply__field textarea {
    resize: vertical;
  }
  .dw-apply__field input:focus,
  .dw-apply__field select:focus,
  .dw-apply__field textarea:focus {
    outline: 2px solid var(--dw-accent);
    outline-offset: -1px;
  }
  .dw-apply__field ::placeholder {
    color: var(--dw-text-2);
    opacity: 1;
  }
  .dw-apply__foot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.4rem;
    margin-top: 1.6rem;
  }
  .dw-apply__note {
    font-size: 1.15rem;
    color: var(--dw-text-2);
    text-align: right;
  }
  .dw-apply__success {
    text-align: center;
    padding: 3.4rem 2.4rem;
  }
  .dw-apply__success-tile {
    width: 4rem;
    height: 4rem;
    margin: 0 auto 1.2rem;
    border-radius: var(--dw-r);
    background: var(--dw-accent-soft);
    color: var(--dw-accent-hover);
    display: grid;
    place-items: center;
  }
  .dw-apply__success-h {
    font-family: var(--dw-font);
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0 0 0.6rem;
  }
  .dw-apply__success-p {
    color: var(--dw-text-2);
    font-size: 1.3rem;
    margin: 0 0 1.6rem;
  }
  .dw-apply__side {
    position: sticky;
    top: 1.8rem;
  }
  .dw-apply__side-body {
    padding: 1.6rem;
  }
  .dw-apply__side-p {
    color: var(--dw-text-2);
    font-size: 1.3rem;
    margin: 0 0 1.4rem;
  }
  .dw-apply__signin {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    border: 1px solid var(--dw-accent);
    background: var(--dw-panel);
    color: var(--dw-accent);
    border-radius: var(--dw-r);
    font-size: 1.3rem;
    font-weight: 700;
    padding: 0.9rem 1.4rem;
    text-decoration: none;
  }
  .dw-apply__signin:hover {
    background: var(--dw-accent-soft);
  }
  .dw-apply__side-note {
    font-size: 1.15rem;
    color: var(--dw-text-3);
    margin: 1rem 0 0;
  }
  @media screen and (max-width: 900px) {
    .dw-apply__cols {
      grid-template-columns: 1fr;
    }
    .dw-apply__side {
      position: static;
    }
    .dw-apply__grid {
      grid-template-columns: 1fr;
    }
    .dw-apply__foot {
      flex-direction: column;
      align-items: stretch;
    }
    .dw-apply__note {
      text-align: left;
    }
    .dw-apply__foot .dw-btn-money {
      width: 100%;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "DW Account Application",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Apply for a business account"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Bulk pricing, offers and Net 30 terms for verified resellers and businesses. No fees."
    },
    {
      "type": "text",
      "id": "fact_1",
      "label": "Fact 1",
      "default": "Wholesale prices on 500+ SKUs, EXW Miami, Newark and Dallas"
    },
    {
      "type": "text",
      "id": "fact_2",
      "label": "Fact 2",
      "default": "Make offers and negotiate directly with our sales team"
    },
    {
      "type": "text",
      "id": "fact_3",
      "label": "Fact 3",
      "default": "Net 30 invoice terms for qualified accounts"
    }
  ],
  "presets": [{ "name": "DW Account Application" }]
}
{% endschema %}
