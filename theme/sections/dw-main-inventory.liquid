{% comment %}
  Digital World Shop: main selling page. Dense, image-free inventory grid.
  Product data expectations (see docs/LIQUID-SETUP.md):
    - metafields: custom.moq (integer), custom.condition ("N" or "R"), custom.warehouse (text)
    - compare_at_price above price renders the Price Drop flag
    - tag "just-launched" renders the Just Launched flag
    - brand rail and in-stock toggle require Search & Discovery filters on vendor + availability
{% endcomment %}

{%- liquid
  assign approved = false
  if section.settings.enable_gating == false
    assign approved = true
  elsif customer and customer.tags contains section.settings.approved_tag
    assign approved = true
  endif
-%}

<div
  class="dw-inv page-width-desktop"
  data-dw-b2b
  data-dw-login-url="{{ routes.account_login_url }}"
  data-dw-customer-email="{{ customer.email }}"
  data-dw-logged-in="{% if customer %}true{% else %}false{% endif %}"
>
  <div class="dw-inv__head">
    <h1>{{ section.settings.heading | default: collection.title }}</h1>
    <span class="dw-inv__sub">
      {{- collection.products_count }} of {{ collection.all_products_count }} SKUs · EXW pricing</span
    >
  </div>

  {%- comment -%} Brand rail from the vendor filter, when configured {%- endcomment -%}
  {%- for filter in collection.filters -%}
    {%- if filter.param_name == 'filter.p.vendor' -%}
      <div class="dw-inv__brands">
        {%- if filter.active_values.size > 0 -%}
          <a class="dw-inv__brand" href="{{ filter.url_to_remove }}">All Brands</a>
        {%- else -%}
          <span class="dw-inv__brand dw-inv__brand--active">All Brands</span>
        {%- endif -%}
        {%- for value in filter.values -%}
          <a
            class="dw-inv__brand{% if value.active %} dw-inv__brand--active{% endif %}"
            href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
          >
            {{ value.label }} <span class="dw-mono">{{ value.count }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endfor -%}

  <form class="dw-inv__toolbar" id="DwFacets">
    <span class="dw-lbl">Filter</span>

    {%- for filter in collection.filters -%}
      {%- case filter.type -%}
        {%- when 'boolean' -%}
          {%- comment -%} Availability renders as the in-stock toggle {%- endcomment -%}
          <label class="dw-inv__toggle">
            <input
              type="checkbox"
              name="{{ filter.param_name }}"
              value="1"
              {% if filter.true_value.active %}
                checked
              {% endif %}
            >
            {{ filter.label }}
          </label>
        {%- when 'list' -%}
          {%- unless filter.param_name == 'filter.p.vendor' -%}
            <select name="{{ filter.param_name }}" aria-label="{{ filter.label }}">
              <option value="">All {{ filter.label }}</option>
              {%- for value in filter.values -%}
                <option
                  value="{{ value.value }}"
                  {% if value.active %}
                    selected
                  {% endif %}
                >
                  {{ value.label }} ({{ value.count }})
                </option>
              {%- endfor -%}
            </select>
          {%- endunless -%}
      {%- endcase -%}
    {%- endfor -%}

    <select name="sort_by" aria-label="{{ 'products.facets.sort_by_label' | t }}">
      {%- for option in collection.sort_options -%}
        <option value="{{ option.value }}" {% if option.value == collection.sort_by %} selected {% endif %}>
          Sort: {{ option.name }}
        </option>
      {%- endfor -%}
    </select>

    <span class="dw-inv__grow"></span>
    <noscript><button class="dw-btn-line">Apply</button></noscript>
  </form>

  <div class="dw-inv__panelwrap dw-panel-box">
    <div class="dw-inv__scroll">
      <div class="dw-inv__cols dw-inv__cols--head">
        <span class="dw-lbl">Product</span>
        <span class="dw-lbl">Cond</span>
        <span class="dw-lbl">MOQ</span>
        <span class="dw-lbl dw-inv__r">Unit Price</span>
        <span class="dw-lbl">Warehouse</span>
        <span class="dw-lbl dw-inv__r">Avail</span>
        <span class="dw-lbl" aria-hidden="true"></span>
        <span class="dw-lbl">Offer</span>
        <span class="dw-lbl">Order</span>
      </div>

      {%- paginate collection.products by section.settings.products_per_page -%}
        {%- for product in collection.products -%}
          {%- liquid
            assign variant = product.selected_or_first_available_variant
            assign moq = product.metafields.custom.moq.value | default: 1
            assign cond = product.metafields.custom.condition.value | slice: 0 | upcase
            assign warehouse = product.metafields.custom.warehouse.value
            assign soldout = false
            unless variant.available
              assign soldout = true
            endunless
            assign qty_known = false
            if variant.inventory_management == 'shopify'
              assign qty_known = true
            endif
            assign low = false
            if qty_known and variant.inventory_quantity > 0 and variant.inventory_quantity < section.settings.low_stock_threshold
              assign low = true
            endif
          -%}
          <div class="dw-inv__cols dw-inv__row{% if soldout %} dw-inv__row--soldout{% endif %}">
            <div class="dw-inv__name">
              <a class="dw-inv__title" href="{{ product.url }}">{{ product.title }}</a>
              <span class="dw-inv__meta">
                {%- if variant.sku != blank -%}
                  <span class="dw-inv__sku dw-mono">{{ variant.sku }}</span>
                {%- endif -%}
                {%- if variant.compare_at_price > variant.price and approved -%}
                  <span class="dw-flag dw-flag--drop">Price Drop</span>
                {%- endif -%}
                {%- if product.tags contains 'just-launched' -%}
                  <span class="dw-flag dw-flag--launch">Just Launched</span>
                {%- endif -%}
              </span>
            </div>

            <span>
              {%- if cond == 'N' -%}
                <span class="dw-cond dw-cond--n" title="New">N</span>
              {%- elsif cond == 'R' -%}
                <span class="dw-cond dw-cond--r" title="Refurbished">R</span>
              {%- endif -%}
            </span>

            <span class="dw-mono dw-inv__moq">{{ moq }}</span>

            <span class="dw-inv__price dw-inv__r">
              {%- if approved -%}
                <span class="dw-mono">{{ variant.price | money }}</span>
                {%- if variant.compare_at_price > variant.price -%}
                  <s class="dw-mono">{{ variant.compare_at_price | money }}</s>
                {%- endif -%}
              {%- else -%}
                <a class="dw-inv__gate" href="{{ routes.account_login_url }}">Sign in for pricing</a>
              {%- endif -%}
            </span>

            <span class="dw-inv__loc">{{ warehouse }}</span>

            <span class="dw-inv__qty dw-inv__r {% if low %}dw-inv__qty--low{% endif %}">
              {%- if soldout -%}
                <span class="dw-soldtag">Sold out</span>
              {%- elsif qty_known -%}
                <span class="dw-mono">{{ variant.inventory_quantity }}</span>
                {%- if low -%}
                  <small>low stock</small>
                {%- endif -%}
              {%- else -%}
                <span class="dw-mono">In stock</span>
              {%- endif -%}
            </span>

            <span class="dw-inv__bellcell">
              <button
                type="button"
                class="dw-bell"
                data-dw-bell
                data-variant-gid="gid://shopify/ProductVariant/{{ variant.id }}"
                data-product-gid="gid://shopify/Product/{{ product.id }}"
                data-sku="{{ variant.sku | escape }}"
                data-title="{{ product.title | escape }}"
                aria-label="Toggle alerts for {{ variant.sku | default: product.title | escape }}"
                aria-pressed="false"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 9a6 6 0 0 0-12 0c0 6-2 7-2 7h16s-2-1-2-7"/><path d="M10.3 20a2 2 0 0 0 3.4 0"/>
                </svg>
              </button>
            </span>

            <span class="dw-inv__offercell">
              {%- if approved and soldout == false -%}
                <button
                  type="button"
                  class="dw-btn-line dw-inv__offerbtn"
                  data-dw-offer
                  data-variant-gid="gid://shopify/ProductVariant/{{ variant.id }}"
                  data-product-gid="gid://shopify/Product/{{ product.id }}"
                  data-sku="{{ variant.sku | escape }}"
                  data-title="{{ product.title | escape }}"
                  data-price-cents="{{ variant.price }}"
                  data-moq="{{ moq }}"
                >
                  Make Offer
                </button>
              {%- endif -%}
            </span>

            <span class="dw-inv__order">
              {%- if approved == false -%}
                <a class="dw-btn-line" href="{{ routes.account_login_url }}">Sign In</a>
              {%- elsif soldout -%}
                {%- if section.settings.waitlist_email != blank -%}
                  <a
                    class="dw-btn-ink"
                    href="mailto:{{ section.settings.waitlist_email }}?subject=Waitlist%20request%3A%20{{ variant.sku | url_encode }}"
                  >
                    Join Waitlist
                  </a>
                {%- endif -%}
              {%- else -%}
                <form class="dw-inv__atc" data-dw-atc>
                  <input type="hidden" name="id" value="{{ variant.id }}">
                  <input
                    class="dw-inv__qtyin dw-mono"
                    type="number"
                    name="quantity"
                    value="{{ moq }}"
                    min="{{ moq }}"
                    step="{{ moq }}"
                    data-moq="{{ moq }}"
                    aria-label="Quantity for {{ variant.sku | default: product.title | escape }}"
                  >
                  <button type="submit" class="dw-btn-money">Add to Cart</button>
                </form>
              {%- endif -%}
            </span>
          </div>
        {%- else -%}
          <div class="dw-inv__empty">No products match these filters.</div>
        {%- endfor -%}

        {%- if paginate.pages > 1 -%}
          <div class="dw-inv__pagination">
            {% render 'pagination', paginate: paginate %}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>

{% style %}
  .dw-inv {
    font-family: var(--dw-font);
    color: var(--dw-text);
    max-width: 148rem;
    margin: 0 auto;
    padding: 1.8rem 2.4rem 6.4rem;
  }
  .dw-inv__head {
    display: flex;
    align-items: baseline;
    gap: 1.2rem;
    margin-bottom: 1.4rem;
  }
  .dw-inv__head h1 {
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
    font-family: var(--dw-font);
  }
  .dw-inv__sub {
    color: var(--dw-text-2);
    font-size: 1.25rem;
  }
  .dw-inv__brands {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.2rem;
  }
  .dw-inv__brand {
    border: 1px solid var(--dw-line);
    background: var(--dw-panel);
    border-radius: var(--dw-r);
    padding: 0.5rem 1.1rem;
    font-size: 1.25rem;
    font-weight: 600;
    display: inline-flex;
    gap: 0.7rem;
    align-items: baseline;
    color: var(--dw-text);
    text-decoration: none;
  }
  .dw-inv__brand .dw-mono {
    font-size: 1.1rem;
    color: var(--dw-text-3);
  }
  .dw-inv__brand:hover {
    border-color: var(--dw-accent);
  }
  .dw-inv__brand--active {
    background: var(--dw-accent-soft);
    border-color: var(--dw-accent);
    color: var(--dw-accent);
  }
  .dw-inv__brand--active .dw-mono {
    color: inherit;
    opacity: 0.75;
  }
  .dw-inv__toolbar {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    border: 1px solid var(--dw-line);
    border-bottom: 0;
    background: var(--dw-panel-2);
    border-radius: var(--dw-r) var(--dw-r) 0 0;
    padding: 0.8rem 1.2rem;
  }
  .dw-inv__toolbar select {
    background: var(--dw-panel);
    border: 1px solid var(--dw-line-strong);
    border-radius: var(--dw-r);
    padding: 0.5rem 0.8rem;
    font-family: var(--dw-font);
    font-size: 1.25rem;
    color: var(--dw-text);
  }
  .dw-inv__toggle {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 1.25rem;
    font-weight: 600;
  }
  .dw-inv__grow {
    flex: 1;
  }
  .dw-inv__panelwrap {
    border-radius: 0 0 var(--dw-r) var(--dw-r);
    overflow: hidden;
  }
  .dw-inv__scroll {
    overflow-x: auto;
  }
  .dw-inv__cols {
    display: grid;
    align-items: center;
    gap: 1.2rem;
    grid-template-columns: minmax(33rem, 1fr) 4.4rem 6.4rem 11rem 8.2rem 6.4rem 3.4rem 10.4rem 19rem;
    padding: 0 1.4rem;
    min-width: 96rem;
  }
  .dw-inv__cols--head {
    background: var(--dw-panel-2);
    border-bottom: 1px solid var(--dw-line);
  }
  .dw-inv__cols--head > span {
    padding: 0.7rem 0;
  }
  .dw-inv__r {
    text-align: right;
  }
  .dw-inv__row {
    border-top: 1px solid var(--dw-line);
    padding-top: 0.8rem;
    padding-bottom: 0.8rem;
  }
  .dw-inv__row:first-of-type {
    border-top: 0;
  }
  .dw-inv__row:hover {
    background: var(--dw-panel-2);
  }
  .dw-inv__row--soldout .dw-inv__title,
  .dw-inv__row--soldout .dw-inv__sku {
    color: var(--dw-text-3);
  }
  .dw-inv__name {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .dw-inv__title {
    font-weight: 500;
    font-size: 1.3rem;
    line-height: 1.35;
    color: var(--dw-text);
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .dw-inv__title:hover {
    color: var(--dw-accent);
  }
  .dw-inv__meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .dw-inv__sku {
    font-size: 1.1rem;
    color: var(--dw-text-3);
  }
  .dw-inv__moq {
    font-size: 1.2rem;
    color: var(--dw-text-2);
  }
  .dw-inv__price .dw-mono {
    font-size: 1.4rem;
    font-weight: 700;
  }
  .dw-inv__price s {
    display: block;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--dw-text-3);
  }
  .dw-inv__gate {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--dw-accent);
    text-decoration: none;
  }
  .dw-inv__gate:hover {
    text-decoration: underline;
  }
  .dw-inv__loc {
    font-size: 1.2rem;
    color: var(--dw-text-2);
  }
  .dw-inv__qty .dw-mono {
    font-size: 1.25rem;
    font-weight: 600;
  }
  .dw-inv__qty--low .dw-mono {
    color: var(--dw-warn);
  }
  .dw-inv__qty small {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--dw-text-3);
  }
  .dw-inv__order {
    display: flex;
    justify-content: flex-end;
  }
  .dw-inv__offercell {
    display: flex;
  }
  .dw-inv__offerbtn {
    width: 100%;
    padding: 0.6rem 0;
    font-size: 1.2rem;
  }
  .dw-inv__atc {
    display: flex;
    gap: 0.6rem;
    align-items: stretch;
  }
  .dw-inv__qtyin {
    width: 5.6rem;
    text-align: center;
    border: 1px solid var(--dw-line-strong);
    border-radius: var(--dw-r);
    background: var(--dw-panel);
    padding: 0.5rem 0.2rem;
    font-size: 1.25rem;
  }
  .dw-inv__qtyin:focus {
    outline: 2px solid var(--dw-accent);
    outline-offset: -1px;
  }
  .dw-inv__empty {
    text-align: center;
    color: var(--dw-text-3);
    padding: 4.4rem 0;
    font-size: 1.3rem;
  }
  .dw-inv__pagination {
    padding: 1.2rem;
    border-top: 1px solid var(--dw-line);
  }
{% endstyle %}

{% render 'dw-offer-modal' %}
<script src="{{ 'dw-inventory.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'dw-b2b.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "DW Inventory Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Live Inventory"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 10,
      "max": 50,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Low stock threshold",
      "min": 5,
      "max": 50,
      "step": 5,
      "default": 15
    },
    {
      "type": "checkbox",
      "id": "enable_gating",
      "label": "Hide prices from non-approved customers",
      "default": false
    },
    {
      "type": "text",
      "id": "approved_tag",
      "label": "Approved customer tag",
      "default": "approved"
    },
    {
      "type": "text",
      "id": "waitlist_email",
      "label": "Waitlist email",
      "info": "Sold-out rows show a Join Waitlist button that emails this address. Leave blank to hide."
    }
  ],
  "presets": [{ "name": "DW Inventory Grid" }]
}
{% endschema %}
