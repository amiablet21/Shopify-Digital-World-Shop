# Public URL of this service once deployed (no trailing slash)
ISSUER=https://id.digitalworldshopus.com
PORT=3000

# Shown by Shopify when you connect the identity provider
# (Settings -> Customer accounts -> identity provider)
SHOPIFY_CLIENT_ID=set-me
SHOPIFY_CLIENT_SECRET=generate-a-long-random-secret
SHOPIFY_REDIRECT_URIS=https://shopify.com/authentication/REPLACE_WITH_VALUE_FROM_SHOPIFY/callback
SHOPIFY_POST_LOGOUT_URIS=

# client_secret_basic or client_secret_post, per Shopify's connect screen
CLIENT_AUTH_METHOD=client_secret_basic

# Long random string used to sign session cookies
COOKIE_KEY=generate-a-long-random-string
